#!/bin/sh
# NetworkManager-backed Wi-Fi setup and recovery for PiFrame.
set -eu

STATE_DIR=/run/piframe
STATE_FILE="$STATE_DIR/network-state.json"
AP_CONNECTION=piframe-setup
WAIT_SECONDS="${PIFRAME_WIFI_WAIT_SECONDS:-60}"

mkdir -p "$STATE_DIR"
chmod 0755 "$STATE_DIR"

write_state() {
  mode="$1"
  ssid="${2-}"
  address="${3-}"
  message="${4-}"
  /usr/bin/python3 - "$STATE_FILE" "$mode" "$ssid" "$address" "$message" <<'PY'
import json
import sys
from pathlib import Path

Path(sys.argv[1]).write_text(json.dumps({
    "mode": sys.argv[2],
    "ssid": sys.argv[3],
    "address": sys.argv[4],
    "message": sys.argv[5],
}) + "\n")
PY
  chmod 0644 "$STATE_FILE"
}

wifi_device() {
  /usr/bin/nmcli -t -f DEVICE,TYPE device status | /usr/bin/awk -F: '$2 == "wifi" { print $1; exit }'
}

wifi_connected() {
  /usr/bin/nmcli -t -f DEVICE,TYPE,STATE device status | /usr/bin/awk -F: '$2 == "wifi" && $3 == "connected" { found=1 } END { exit !found }'
}

has_saved_wifi() {
  /usr/bin/nmcli -t -f TYPE connection show | /usr/bin/grep -qx wifi
}

portal_address() {
  device="$1"
  /usr/sbin/ip -4 -o addr show dev "$device" scope global 2>/dev/null | /usr/bin/awk '{ split($4, value, "/"); print value[1]; exit }'
}

start_portal() {
  device="$(wifi_device)"
  if [ -z "$device" ]; then
    write_state setup "" "" "No Wi-Fi adapter was found. Connect a supported Wi-Fi adapter and restart PiFrame."
    return 1
  fi

  suffix="$(/bin/hostname | /usr/bin/cksum | /usr/bin/awk '{ printf "%04X", $1 % 65536 }')"
  ssid="PiFrame Setup-$suffix"
  /usr/bin/nmcli connection down id "$AP_CONNECTION" >/dev/null 2>&1 || true
  /usr/bin/nmcli connection delete id "$AP_CONNECTION" >/dev/null 2>&1 || true
  # Create a new connection rather than altering nmcli's generated hotspot
  # profile. Generated profiles can retain a WEP/WPA secret and then fail when
  # activated as an intentionally open network.
  /usr/bin/nmcli connection add type wifi ifname "$device" con-name "$AP_CONNECTION" \
    autoconnect no ssid "$ssid" >/dev/null
  /usr/bin/nmcli connection modify "$AP_CONNECTION" \
    802-11-wireless.mode ap \
    ipv4.method shared \
    ipv6.method disabled >/dev/null
  /usr/bin/nmcli connection down id "$AP_CONNECTION" >/dev/null 2>&1 || true
  /usr/bin/nmcli connection up id "$AP_CONNECTION" >/dev/null
  address="$(portal_address "$device")"
  write_state setup "$ssid" "${address:-10.42.0.1}" "Connect to the temporary PiFrame network, then use the setup address to enter your home Wi-Fi details."
}

connect() {
  IFS= read -r ssid || true
  IFS= read -r password || true
  if [ -z "$ssid" ]; then
    echo "A Wi-Fi network name is required." >&2
    exit 64
  fi
  device="$(wifi_device)"
  if [ -z "$device" ]; then
    echo "No Wi-Fi adapter was found." >&2
    exit 69
  fi
  write_state connecting "" "" "Connecting to Wi-Fi…"
  /usr/bin/nmcli connection down id "$AP_CONNECTION" >/dev/null 2>&1 || true
  connection="piframe-wifi-$(printf '%s' "$ssid" | /usr/bin/cksum | /usr/bin/awk '{ print $1 }')"
  /usr/bin/nmcli connection delete id "$connection" >/dev/null 2>&1 || true
  if [ -n "$password" ]; then
    connected=0
    /usr/bin/nmcli device wifi connect "$ssid" password "$password" ifname "$device" name "$connection" >/dev/null || connected=1
  else
    connected=0
    /usr/bin/nmcli device wifi connect "$ssid" ifname "$device" name "$connection" >/dev/null || connected=1
  fi
  if [ "$connected" -ne 0 ]; then
    start_portal || true
    echo "Could not connect to that Wi-Fi network." >&2
    exit 1
  fi
  if wifi_connected; then
    write_state online "" "" "Connected to Wi-Fi."
    exit 0
  fi
  start_portal
  echo "Could not connect to that Wi-Fi network." >&2
  exit 1
}

startup() {
  if wifi_connected; then
    write_state online "" "" "Connected to Wi-Fi."
    exit 0
  fi
  if has_saved_wifi; then
    write_state connecting "" "" "Trying saved Wi-Fi networks…"
    elapsed=0
    while [ "$elapsed" -lt "$WAIT_SECONDS" ]; do
      sleep 2
      if wifi_connected; then
        write_state online "" "" "Connected to Wi-Fi."
        exit 0
      fi
      elapsed=$((elapsed + 2))
    done
  fi
  start_portal
}

case "${1-}" in
  startup) startup ;;
  connect) connect ;;
  *) echo "Usage: $0 {startup|connect}" >&2; exit 64 ;;
esac
