{
  "name": "piframe",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first Raspberry Pi digital picture frame",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "dev": "node --import tsx src/server.ts",
    "dev:watch": "node --watch --import tsx src/server.ts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@types/busboy": "^1.5.4",
    "better-sqlite3": "^12.2.0",
    "busboy": "^1.6.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.3.0",
    "tsx": "^4.23.4",
    "typescript": "^5.9.2"
  }
}
